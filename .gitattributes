# Line endings: the guard suites run under WSL bash with $-anchored greps;
# CRLF checkouts break them. Normalize text sources to LF on every platform.
* text=auto
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.service text eol=lf
*.rules text eol=lf
