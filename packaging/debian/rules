#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	# Install tools under the SAME suffix-free basenames install_dkms.sh uses in
	# /usr/local/bin, because the shipped systemd units' ExecStart= reference
	# those names (parity with install_dkms.sh:485-523). /usr/local/bin is a
	# deliberate choice, not an oversight: the manual installer is the primary
	# path and /usr/local is its correct location; moving only the package to
	# /usr/bin would split the ExecStart contract. Kept identical across
	# deb/rpm/PKGBUILD for one source of truth.
	mkdir -p debian/lenovo-d330-fix/usr/local/bin
	cp tools/d330-* debian/lenovo-d330-fix/usr/local/bin/
	cp tools/lenovo-d330-power-tune.sh debian/lenovo-d330-fix/usr/local/bin/
	# d330-acpi-override.sh and d330-pen-config.sh are development-only helpers
	# (CHANGES_AUDIT.md 8.1) and must not ship in packages.
	rm -f debian/lenovo-d330-fix/usr/local/bin/d330-acpi-override.sh \
	      debian/lenovo-d330-fix/usr/local/bin/d330-pen-config.sh
	# Rename to the suffix-free names the shipped units Exec.
	for f in d330-tablet-daemon.py d330-sensor-filter.py d330-tray.py \
	         d330-auto-hibernate.py d330-refresh-screen.sh d330-microsd-setup.sh \
	         d330-thermal-tune.sh d330-fastboot-tune.sh d330-vaapi-check.sh \
	         lenovo-d330-power-tune.sh; do \
	    mv debian/lenovo-d330-fix/usr/local/bin/$$f \
	       debian/lenovo-d330-fix/usr/local/bin/$${f%.*}; \
	done
	# cp preserves 0644 and dh_fixperms only normalizes usr/bin, not
	# /usr/local/bin, so make every installed tool executable.
	chmod 755 debian/lenovo-d330-fix/usr/local/bin/*
	# Tray autostart entry (Exec=/usr/local/bin/d330-tray).
	mkdir -p debian/lenovo-d330-fix/etc/xdg/autostart
	cp patches/hardware_controls/etc/xdg/autostart/d330-tray.desktop \
	   debian/lenovo-d330-fix/etc/xdg/autostart/
	# Install modprobe
	mkdir -p debian/lenovo-d330-fix/etc/modprobe.d
	cp patches/*/etc/modprobe.d/*.conf debian/lenovo-d330-fix/etc/modprobe.d/
	# Install udev
	mkdir -p debian/lenovo-d330-fix/etc/udev/rules.d debian/lenovo-d330-fix/etc/udev/hwdb.d
	cp patches/*/etc/udev/rules.d/*.rules debian/lenovo-d330-fix/etc/udev/rules.d/
	cp patches/*/etc/udev/hwdb.d/*.hwdb debian/lenovo-d330-fix/etc/udev/hwdb.d/
	# Install systemd
	mkdir -p debian/lenovo-d330-fix/etc/systemd/system
	cp patches/*/etc/systemd/system/*.service debian/lenovo-d330-fix/etc/systemd/system/
	# Install systemd USER unit (tablet daemon); the deb postinst enables it with
	# `systemctl --global enable`, which must find the unit at /usr/lib/systemd/user.
	mkdir -p debian/lenovo-d330-fix/usr/lib/systemd/user
	cp patches/*/usr/lib/systemd/user/*.service debian/lenovo-d330-fix/usr/lib/systemd/user/
	# Install PipeWire filter-chain DSP fragments into the RUNNING daemon's
	# pipewire.conf.d (Phase 38). patches/*/etc/pipewire/** was shipped by no
	# packager before, so the now-active speaker/RNNoise graphs were missing from
	# packaged installs. dh_install picks these up from the debian/<pkg> tree.
	mkdir -p debian/lenovo-d330-fix/etc/pipewire/pipewire.conf.d
	cp patches/audio_dsp/etc/pipewire/pipewire.conf.d/*.conf debian/lenovo-d330-fix/etc/pipewire/pipewire.conf.d/
