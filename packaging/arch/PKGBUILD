# Maintainer: Antigravity Community <community@example.com>
pkgname=lenovo-d330-fix
pkgver=5.0.0
pkgrel=1
pkgdesc="Complete hardware integration and screen freeze fix for Lenovo IdeaPad D330-10IGL"
arch=('any')
url="https://github.com/lucasgabmoreno/linuxmint_lenovod330"
license=('GPL2')
depends=('dkms' 'tlp' 'pipewire' 'python' 'libinput')
optdepends=('iio-sensor-proxy: orientation and ambient light auto-rotation'
            'v4l2loopback-dkms: virtual loopback webcam bridge'
            'thermald: RAPL/thermal policy owner (fallback: tools/d330-thermal-tune.sh)'
            'earlyoom: userspace OOM prevention on 4GB RAM'
            'zram-generator: compressed in-RAM swap'
            'rnnoise: RNNoise runtime library (LADSPA plugin built separately)'
            'libva-utils: vainfo for VA-API diagnostics'
            'glib2: gsettings desktop session wiring'
            'xdg-utils: desktop notification / autostart helpers')

package() {
    # Install executables (d330-acpi-override.sh and d330-pen-config.sh are
    # development-only helpers — CHANGES_AUDIT.md 8.1 — and must not ship).
    install -d "${pkgdir}/usr/local/bin"
    install -m 755 "${srcdir}"/../tools/d330-* "${pkgdir}/usr/local/bin/"
    rm -f "${pkgdir}/usr/local/bin/d330-acpi-override.sh" \
          "${pkgdir}/usr/local/bin/d330-pen-config.sh"

    # Install modprobe
    install -d "${pkgdir}/etc/modprobe.d"
    install -m 644 "${srcdir}"/../patches/*/etc/modprobe.d/*.conf "${pkgdir}/etc/modprobe.d/"

    # Install udev
    install -d "${pkgdir}/etc/udev/rules.d"
    install -d "${pkgdir}/etc/udev/hwdb.d"
    install -m 644 "${srcdir}"/../patches/*/etc/udev/rules.d/*.rules "${pkgdir}/etc/udev/rules.d/"
    install -m 644 "${srcdir}"/../patches/*/etc/udev/hwdb.d/*.hwdb "${pkgdir}/etc/udev/hwdb.d/"

    # Install systemd
    install -d "${pkgdir}/etc/systemd/system"
    install -m 644 "${srcdir}"/../patches/*/etc/systemd/system/*.service "${pkgdir}/etc/systemd/system/"

    # Install systemd USER unit (tablet daemon); enabled globally by the desktop
    # session hook, so it must land under /usr/lib/systemd/user.
    install -d "${pkgdir}/usr/lib/systemd/user"
    install -m 644 "${srcdir}"/../patches/*/usr/lib/systemd/user/*.service "${pkgdir}/usr/lib/systemd/user/"

    # Install PipeWire filter-chain DSP fragments into the RUNNING daemon's
    # pipewire.conf.d (Phase 38); patches/*/etc/pipewire/** was previously
    # shipped by no packager.
    install -d "${pkgdir}/etc/pipewire/pipewire.conf.d"
    install -m 644 "${srcdir}"/../patches/audio_dsp/etc/pipewire/pipewire.conf.d/*.conf "${pkgdir}/etc/pipewire/pipewire.conf.d/"
}
