From: D330 Linux Fix Project <engineering@lenovo-d330-fix.local>
Subject: [PATCH] android: drm/i915: Fix reset sequence order on GLK VBTs with empty DEASSERT_RESET

Adapted from upstream i915 issue #13225 (note 3698515, Lucas Moreno),
validated 10/10 S3 resumes + 10/10 boots on a Lenovo IdeaPad D330-10IGL
(82H0, GLK-R UHD 600, empty VBT MIPI_SEQ_DEASSERT_RESET, reset pulse
GPIO 160 inside MIPI_SEQ_INIT_OTP) on Linux 7.0.14.

The upstream v7.0 adaptation changed the dispatch predicate to
display->platform.geminilake; this tree predates the intel_display
refactor, so IS_GEMINILAKE(i915) is used directly.
---
--- a/drivers/gpu/drm/i915/display/intel_bios.c
+++ b/drivers/gpu/drm/i915/display/intel_bios.c
@@ -1316,10 +1316,95 @@
  * these devices we split the init OTP sequence into a deassert sequence and
  * the actual init OTP part.
  */
+/*
+ * Count the elements of a v3 MIPI sequence, and report whether all of
+ * them are GPIO or delay elements (i.e. nothing that needs the DSI host
+ * to be up, like sending a packet).
+ */
+static int mipi_seq_v3_count_elems(const u8 *seq, bool *gpio_delay_only)
+{
+	const u8 *p = seq + 5;	/* skip the sequence byte and the size */
+	const u8 *end = seq + 5 + *((const u32 *)(seq + 1));
+	int count = 0;
+
+	*gpio_delay_only = true;
+
+	while (p < end) {
+		u8 op = *p++;
+
+		if (op == MIPI_SEQ_ELEM_END)
+			break;
+		if (p >= end) {
+			*gpio_delay_only = false;
+			break;
+		}
+		if (op != MIPI_SEQ_ELEM_GPIO && op != MIPI_SEQ_ELEM_DELAY)
+			*gpio_delay_only = false;
+
+		p += 1 + *p;	/* length byte + payload */
+		count++;
+	}
+
+	return count;
+}
+
+/*
+ * Some GLK VBTs (e.g. Lenovo IdeaPad D330-10IGL) have an empty
+ * MIPI_SEQ_DEASSERT_RESET and do the whole panel reset pulse from
+ * MIPI_SEQ_INIT_OTP instead. INIT_OTP runs after the DSI host has been
+ * brought up, but the panel reset must happen before that. When
+ * INIT_OTP only contains GPIO and delay elements, run it as
+ * DEASSERT_RESET instead.
+ */
+static void glk_fixup_mipi_sequences(struct drm_i915_private *i915)
+{
+	u8 *deassert = (u8 *)i915->vbt.dsi.sequence[MIPI_SEQ_DEASSERT_RESET];
+	u8 *init_otp = (u8 *)i915->vbt.dsi.sequence[MIPI_SEQ_INIT_OTP];
+	bool gpio_delay_only;
+
+	if (i915->vbt.dsi.seq_version != 3 ||
+	    i915->vbt.dsi.config->is_cmd_mode)
+		return;
+
+	if (!init_otp || !i915->vbt.dsi.sequence[MIPI_SEQ_ASSERT_RESET])
+		return;
+
+	/* Only if DEASSERT_RESET is missing or empty */
+	if (deassert && mipi_seq_v3_count_elems(deassert, &gpio_delay_only))
+		return;
+
+	/* And INIT_OTP only toggles GPIOs and waits */
+	if (!mipi_seq_v3_count_elems(init_otp, &gpio_delay_only) ||
+	    !gpio_delay_only)
+		return;
+
+	drm_dbg_kms(&i915->drm,
+		    "Running INIT_OTP (GPIO/delay only) as DEASSERT_RESET\n");
+
+	/* The sequence executor checks the id byte of each sequence */
+	init_otp[0] = MIPI_SEQ_DEASSERT_RESET;
+	i915->vbt.dsi.sequence[MIPI_SEQ_DEASSERT_RESET] = init_otp;
+
+	if (deassert) {
+		deassert[0] = MIPI_SEQ_INIT_OTP;
+		i915->vbt.dsi.sequence[MIPI_SEQ_INIT_OTP] = deassert;
+	} else {
+		i915->vbt.dsi.sequence[MIPI_SEQ_INIT_OTP] = NULL;
+	}
+}
 static void fixup_mipi_sequences(struct drm_i915_private *i915)
 {
 	u8 *init_otp;
 	int len;
+
+	/*
+	 * GLK VBTs (e.g. Lenovo IdeaPad D330-10IGL) put the panel reset
+	 * pulse into INIT_OTP; run it as DEASSERT_RESET instead.
+	 */
+	if (IS_GEMINILAKE(i915)) {
+		glk_fixup_mipi_sequences(i915);
+		return;
+	}
 
 	/* Limit this to VLV for now. */
 	if (!IS_VALLEYVIEW(i915))
