# Lenovo IdeaPad D330 Runtime Power Management Udev Rules
#
# Ownership split (Phase 40): TLP is the single runtime-PM owner for the
# classes it manages -- PCI/PCIe, USB and the Intel audio DSP -- via
# RUNTIME_PM_ON_AC / RUNTIME_PM_ON_BAT in
# /etc/tlp.d/50-lenovo-d330.conf. udev MUST NOT also write the runtime-PM
# control attribute for those classes, or two writers race and TLP's AC/DC
# policy is silently lost.
#
# The rules below cover ONLY the controllers TLP does not manage:
# the eMMC host controller and the detachable dock.

# eMMC host controller runtime PM (not covered by TLP's PCI runtime PM)
ACTION=="add", SUBSYSTEM=="mmc", ATTR{power/control}="auto"

# Detachable dock (17ef:*): TLP's USB_DENYLIST="17ef:*" already excludes the
# dock, so udev is the single writer here and pins the dock's keyboard/touchpad
# runtime PM on (never autosuspend).
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="17ef", ATTR{power/control}="on"

# Re-apply the AC-aware CPU performance cap when the power source changes, so
# plugging AC lifts the max_perf_pct cap without a reboot (Phase 40).
ACTION=="change", SUBSYSTEM=="power_supply", RUN+="/bin/systemctl --no-block restart lenovo-d330-power.service"
