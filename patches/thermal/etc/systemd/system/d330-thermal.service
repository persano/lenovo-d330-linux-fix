[Unit]
Description=Lenovo IdeaPad D330 RAPL Thermal Power Configuration
After=systemd-modules-load.service
ConditionPathExists=/sys/class/powercap/intel-rapl

[Service]
Type=oneshot
# Fallback only: skip when thermald is the active runtime thermal/RAPL owner,
# so the two never write the RAPL constraint knobs concurrently.
ExecCondition=/bin/sh -c '! systemctl is-active --quiet thermald'
ExecStart=/usr/local/bin/d330-thermal-tune --apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
