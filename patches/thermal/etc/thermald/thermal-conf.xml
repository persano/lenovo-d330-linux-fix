<?xml version="1.0"?>
<!-- Lenovo IdeaPad D330-10IGL Thermal Daemon Configuration -->
<!-- Smooth RAPL scaling prevents sudden 800 MHz thermal cliff in fanless chassis -->
<ThermalConfiguration>
  <Platform>
    <Name>Lenovo IdeaPad D330</Name>
    <ProductName>*</ProductName>
    <Preference>QUIET</Preference>
    <ThermalZones>
      <ThermalZone>
        <Type>cpu</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>x86_pkg_temp</SensorType>
            <Temperature>72000</Temperature>
            <Type>Passive</Type>
            <CoolingDevice>
              <Type>rapl_controller</Type>
              <SamplingPeriod>1</SamplingPeriod>
            </CoolingDevice>
          </TripPoint>
          <TripPoint>
            <SensorType>x86_pkg_temp</SensorType>
            <Temperature>85000</Temperature>
            <Type>Critical</Type>
            <CoolingDevice>
              <Type>rapl_controller</Type>
              <SamplingPeriod>1</SamplingPeriod>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
    </ThermalZones>
  </Platform>
</ThermalConfiguration>
