# Lenovo IdeaPad D330 Touchscreen hwdb entries
#
# The value is the IDENTITY matrix ("no extra transform") on purpose. The
# portrait panel's rotation is reported by the DRM connector
# (`video=DSI-1:panel_orientation=right_side_up`) and Wayland compositors fold
# that into the output transform and already rotate absolute input to match, so
# a rotation matrix here would rotate touch a second time (inverted touch). X11
# gets the real rotation from
# patches/touchscreen/etc/X11/xorg.conf.d/50-touchscreen-d330.conf.
#
# Lookup key: systemd's own rules compose `evdev:` lookups as
#   evdev:name:<input device name>:dmi:<dmi modalias>
# (the old `touchscreen:` namespace is never composed; libinput >=1.12 dropped
# hwdb model configuration, so those keys were inert).
#
# Match on the space-free DMI product code. The DMI modalias product string
# carries a space (`pvrLenovo ideapad D330-10IGL`), so a space-stripped product
# pattern never matches:
#   IGL = Type 82H0, IGM = Types 81MD / 81H3

# IdeaPad D330-10IGL (Type 82H0)
evdev:name:Goodix Capacitive TouchScreen:dmi:*:svnLENOVO:pn82H0:*
 LIBINPUT_CALIBRATION_MATRIX=1 0 0 0 1 0

# IdeaPad D330-10IGM (Type 81MD)
evdev:name:Goodix Capacitive TouchScreen:dmi:*:svnLENOVO:pn81MD:*
 LIBINPUT_CALIBRATION_MATRIX=1 0 0 0 1 0

# IdeaPad D330-10IGM (Type 81H3)
evdev:name:Goodix Capacitive TouchScreen:dmi:*:svnLENOVO:pn81H3:*
 LIBINPUT_CALIBRATION_MATRIX=1 0 0 0 1 0

# Generic fallback for a GDIX1001 ACPI device whose input name differs.
evdev:name:GDIX1001*:dmi:*:svnLENOVO:*
 LIBINPUT_CALIBRATION_MATRIX=1 0 0 0 1 0
