# Lenovo IdeaPad D330 Touchscreen and Active Pen udev configuration
# Matches Goodix I2C Touchscreen controller (GDIX1001)

# No LIBINPUT_CALIBRATION_MATRIX is set here on purpose. The panel is natively
# portrait (800x1280) and the DRM connector reports its rotation via
# `video=DSI-1:panel_orientation=right_side_up` (see
# 50-lenovo-d330-boot.cfg). Wayland compositors (KWin, Mutter) fold that panel
# orientation into the output transform AND rotate absolute input devices to
# match, so adding a matrix here rotates touch a second time (90 deg + 90 deg =
# 180 deg, i.e. inverted touch). The matrix below is therefore the identity
# ("no extra transform"); the compositor supplies the orientation.
#
# X11 has no equivalent panel-orientation handling in the X server, so X11 gets
# the real rotation from
# patches/touchscreen/etc/X11/xorg.conf.d/50-touchscreen-d330.conf.
#
# Palm pressure/size thresholds are NOT set here: libinput reads model
# attributes from quirks files, not udev properties -- see
# patches/touchpad_pen/usr/share/libinput/60-lenovo-d330.quirks.
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="Goodix Capacitive TouchScreen*", \
    ENV{LIBINPUT_CALIBRATION_MATRIX}="1 0 0 0 1 0"

# Active Stylus / Pen match
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="*Pen*|*Stylus*|*GDIX1001*Pen*", \
    ENV{LIBINPUT_CALIBRATION_MATRIX}="1 0 0 0 1 0", \
    ENV{ID_INPUT_TABLET}="1"
