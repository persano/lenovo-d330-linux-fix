+static void quirk_dsi_resume_full_cycle(struct intel_display *display)
+{
+	intel_set_quirk(display, QUIRK_DSI_RESUME_FULL_CYCLE);
+	drm_info(display->drm, "Applying DSI resume full-cycle quirk\n");
+}
