+/*
+ * Lenovo D330 (82H0) DSI resume quirk: the panel is lit but shows no image
+ * right after S3 resume even though the VBT panel-power sequences ran. A
+ * full i915 re-probe (unbind/bind) restores the image; the difference is a
+ * complete encoder teardown plus re-enable from a quiesced state. Schedule
+ * one such cycle a moment after the normal resume has settled.
+ *
+ * The quirk matches a single machine type, so a file-static work item is
+ * acceptable; a multi-quirk-driver version would hang the work off
+ * struct intel_display instead.
+ */
+static struct intel_display *d330_cycle_display;
+static void intel_d330_dsi_resume_cycle(struct work_struct *w);
+static DECLARE_DELAYED_WORK(d330_dsi_resume_cycle_work,
+			    intel_d330_dsi_resume_cycle);
+
+static void intel_d330_dsi_resume_cycle(struct work_struct *w)
+{
+	struct intel_display *display = d330_cycle_display;
+	struct drm_device *dev;
+	struct drm_atomic_state *state;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_crtc_state *crtc_state;
+	struct drm_crtc *crtc;
+	int ret, i;
+
+	if (!display || !intel_has_quirk(display, QUIRK_DSI_RESUME_FULL_CYCLE))
+		return;
+
+	dev = display->drm;
+
+	drm_modeset_acquire_init(&ctx, 0);
+	for (;;) {
+		state = drm_atomic_helper_duplicate_state(dev, &ctx);
+		if (!IS_ERR(state) || PTR_ERR(state) != -EDEADLK)
+			break;
+		drm_modeset_backoff(&ctx);
+	}
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+	if (IS_ERR(state)) {
+		drm_err(dev, "D330 DSI cycle: snapshot failed %pe\n", state);
+		return;
+	}
+
+	/* Full teardown: the encoder disable path runs the DISPLAY_OFF /
+	 * POWER_OFF VBT sequences and drops the panel rails. */
+	drm_modeset_acquire_init(&ctx, 0);
+	for (;;) {
+		ret = drm_atomic_helper_disable_all(dev, &ctx);
+		if (ret != -EDEADLK)
+			break;
+		drm_modeset_backoff(&ctx);
+	}
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+	if (ret) {
+		drm_err(dev, "D330 DSI cycle: disable failed %d\n", ret);
+		drm_atomic_state_put(state);
+		return;
+	}
+
+	/* Rails down; the PP machinery completes the remaining power-cycle
+	 * window itself during the re-enable. */
+	msleep(2000);
+
+	state->acquire_ctx = &ctx;
+	drm_modeset_acquire_init(&ctx, 0);
+	for (;;) {
+		ret = drm_modeset_lock_all_ctx(dev, &ctx);
+		if (ret != -EDEADLK)
+			break;
+		drm_modeset_backoff(&ctx);
+	}
+	for_each_new_crtc_in_state(state, crtc, crtc_state, i)
+		crtc_state->mode_changed = true;
+	if (!ret)
+		ret = drm_atomic_helper_commit_duplicated_state(state, &ctx);
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+	drm_atomic_state_put(state);
+	if (ret)
+		drm_err(dev, "D330 DSI cycle: re-enable failed %d\n", ret);
+	else
+		drm_info(dev, "D330 DSI cycle: encoder re-enabled\n");
+
+	drm_kms_helper_hotplug_event(dev);
+}
