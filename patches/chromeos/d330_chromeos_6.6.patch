From: Antigravity Autonomous Agent <engineering@lenovo-d330-fix.local>
Subject: [PATCH] CHROMIUM: drm/i915: Add Lenovo IdeaPad D330-10IGL (82H0) PPS delay and orientation quirks
Date: Wed, 7 Oct 2026 18:00:00 +0000

Fixes black screen / panel latch-up on wake from Modern Standby / S0ix on
Lenovo IdeaPad D330-10IGL (Type 82H0, Intel Gemini Lake Refresh UHD 600)
running ChromeOS kernel 6.6+.

The primary fix is the skl_universal_plane.c hunk: the panel is natively
portrait, so userspace scans out rotated 90/270 degrees, and i915 rejects a
render-compressed (CCS) scanout framebuffer combined with that rotation in
skl_plane_check_fb() ("RC support only with 0/180 degree rotation"), which
makes every atomic commit fail with -EINVAL and leaves the display black. Stop
advertising CCS on 82H0 so userspace falls back to a Y-tiled surface. The PPS
delay and orientation quirks below are kept as a hedge; on-device tracing found
the resume path already runs the full panel power sequence, so the PPS clamp is
not the cause (see docs/research/DISPLAY_RESUME_CCS_MODIFIER.md).

Re-adapted 2026-10-20 against chromeos-6.6 tip a534360e: the earlier revision
was context-anchored to a post-refactor (intel_display) tree and did not apply
to chromeos-6.6; per-file adaptations are recorded in
patches/chromeos/README.md (Phase 59 pre-verification block).

Signed-off-by: Antigravity Autonomous Agent <engineering@lenovo-d330-fix.local>
---
 drivers/gpu/drm/drm_panel_orientation_quirks.c     | 14 ++++++++++++++
 drivers/gpu/drm/i915/display/intel_pps.c           |  8 ++++++++
 drivers/gpu/drm/i915/display/intel_quirks.c        | 19 +++++++++++++++++++
 drivers/gpu/drm/i915/display/intel_quirks.h        |  1 +
 drivers/gpu/drm/i915/display/skl_universal_plane.c | 13 +++++++++++++
 5 files changed, 55 insertions(+)

diff --git a/drivers/gpu/drm/drm_panel_orientation_quirks.c b/drivers/gpu/drm/drm_panel_orientation_quirks.c
index 036b095c9..7b20f7f44 100644
--- a/drivers/gpu/drm/drm_panel_orientation_quirks.c
+++ b/drivers/gpu/drm/drm_panel_orientation_quirks.c
@@ -159,6 +159,12 @@ static const struct drm_dmi_panel_orientation_data lcd1600x2560_rightside_up = {
 	.orientation = DRM_MODE_PANEL_ORIENTATION_RIGHT_UP,
 };
 
+static const struct drm_dmi_panel_orientation_data lenovo_ideapad_d330_10igl_800x1280 = {
+	.width = 800,
+	.height = 1280,
+	.orientation = DRM_MODE_PANEL_ORIENTATION_RIGHT_UP,
+};
+
 static const struct dmi_system_id orientation_data[] = {
 	{	/* Acer One 10 (S1003) */
 		.matches = {
@@ -414,6 +420,14 @@ static const struct dmi_system_id orientation_data[] = {
 		  DMI_EXACT_MATCH(DMI_PRODUCT_VERSION, "Lenovo ideapad D330-10IGL"),
 		},
 		.driver_data = (void *)&lcd800x1280_rightside_up,
+	}, {	/* Lenovo IdeaPad D330-10IGL (82H0) - same panel; entry kept alongside
+	       * the upstream one above (identical match + orientation data).
+	       */
+		.matches = {
+		  DMI_EXACT_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+		  DMI_MATCH(DMI_PRODUCT_VERSION, "Lenovo ideapad D330-10IGL"),
+		},
+		.driver_data = (void *)&lenovo_ideapad_d330_10igl_800x1280,
 	}, {	/* Lenovo IdeaPad Duet 3 10IGL5 */
 		.matches = {
 		  DMI_EXACT_MATCH(DMI_SYS_VENDOR, "LENOVO"),
diff --git a/drivers/gpu/drm/i915/display/intel_pps.c b/drivers/gpu/drm/i915/display/intel_pps.c
index a8fa3a209..f76f31fac 100644
--- a/drivers/gpu/drm/i915/display/intel_pps.c
+++ b/drivers/gpu/drm/i915/display/intel_pps.c
@@ -1438,6 +1438,14 @@ static void pps_init_delays(struct intel_dp *intel_dp)
 	intel_dp->pps.panel_power_cycle_delay = get_delay(t11_t12);
 #undef get_delay
 
+	/* Enforce safe minimum 600ms power-cycle delay for slow TCON */
+	if (intel_has_quirk(dev_priv, QUIRK_INCREASE_PPS_CYCLE_DELAY)) {
+		if (intel_dp->pps.panel_power_cycle_delay < 6000) {
+			drm_info(&dev_priv->drm, "Clamping PPS power-cycle delay to 600ms\n");
+			intel_dp->pps.panel_power_cycle_delay = 6000;
+		}
+	}
+
 	drm_dbg_kms(&dev_priv->drm,
 		    "panel power up delay %d, power down delay %d, power cycle delay %d\n",
 		    intel_dp->pps.panel_power_up_delay,
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.c b/drivers/gpu/drm/i915/display/intel_quirks.c
index 8fb27bf1a..40b2bbb76 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.c
+++ b/drivers/gpu/drm/i915/display/intel_quirks.c
@@ -96,6 +96,12 @@ static int intel_dmi_no_pps_backlight(const struct dmi_system_id *id)
 	return 1;
 }
 
+static void quirk_lenovo_d330_pps(struct drm_i915_private *i915)
+{
+	intel_set_quirk(i915, QUIRK_INCREASE_PPS_CYCLE_DELAY);
+	drm_info(&i915->drm, "Applying Lenovo D330 PPS power-cycle delay quirk (>=600ms)\n");
+}
+
 static const struct intel_dmi_quirk intel_dmi_quirks[] = {
 	{
 		.dmi_id_list = &(const struct dmi_system_id[]) {
@@ -142,6 +148,19 @@ static const struct intel_dmi_quirk intel_dmi_quirks[] = {
 		},
 		.hook = quirk_no_pps_backlight_power_hook,
 	},
+	{
+		.dmi_id_list = &(const struct dmi_system_id[]) {
+			{
+				.ident = "Lenovo IdeaPad D330-10IGL",
+				.matches = {
+					DMI_EXACT_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+					DMI_MATCH(DMI_PRODUCT_VERSION, "Lenovo ideapad D330-10IGL"),
+				},
+			},
+			{ }
+		},
+		.hook = quirk_lenovo_d330_pps,
+	},
 };
 
 static struct intel_quirk intel_quirks[] = {
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.h b/drivers/gpu/drm/i915/display/intel_quirks.h
index 0596e8fd0..7e1e6a3ab 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.h
+++ b/drivers/gpu/drm/i915/display/intel_quirks.h
@@ -18,6 +18,7 @@ enum intel_quirk_id {
 	QUIRK_LVDS_SSC_DISABLE,
 	QUIRK_NO_PPS_BACKLIGHT_POWER_HOOK,
 	QUIRK_SKIP_LINK_CHECK,
+	QUIRK_INCREASE_PPS_CYCLE_DELAY,
 };
 
 void intel_init_quirks(struct drm_i915_private *i915);
diff --git a/drivers/gpu/drm/i915/display/skl_universal_plane.c b/drivers/gpu/drm/i915/display/skl_universal_plane.c
index 686c5af07..b0d7380a8 100644
--- a/drivers/gpu/drm/i915/display/skl_universal_plane.c
+++ b/drivers/gpu/drm/i915/display/skl_universal_plane.c
@@ -3,6 +3,8 @@
  * Copyright © 2020 Intel Corporation
  */
 
+#include <linux/dmi.h>
+
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_blend.h>
 #include <drm/drm_damage_helper.h>
@@ -2103,6 +2105,17 @@ static bool skl_plane_format_mod_supported(struct drm_plane *_plane,
 {
 	struct intel_plane *plane = to_intel_plane(_plane);
 
+	/*
+	 * Lenovo IdeaPad D330-10IGL: a CCS (render-compressed) framebuffer
+	 * cannot be scanned out with 90/270 rotation (skl_plane_check_fb
+	 * rejects it), so the portrait output fails every atomic commit
+	 * after resume. Keep CCS out of this plane's IN_FORMATS so the
+	 * compositor picks a Y-tiled surface instead.
+	 */
+	if (dmi_match(DMI_PRODUCT_NAME, "82H0") &&
+	    intel_fb_is_ccs_modifier(modifier))
+		return false;
+
 	if (!intel_fb_plane_supports_modifier(plane, modifier))
 		return false;
 
