[Unit]
Description=Lenovo IdeaPad D330 Resume Swapfile Setup
# Disk-backed resume swap for hibernation (root eMMC only -- never removable
# media, MicroSD swap is deferred). The swap header location is baked into the
# kernel cmdline as resume_offset= at install time; deleting or recreating
# /var/swapfile would move the header and invalidate that resume_offset
# (33-RESEARCH R4), so this unit creates the file ONLY when absent and never
# rewrites an existing one.
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if [ -e /var/swapfile ]; then grep -q "^/var/swapfile" /proc/swaps || swapon /var/swapfile; else ROOT_FSTYPE=$$(findmnt -no FSTYPE / 2>/dev/null || stat -f -c %T /); case "$${ROOT_FSTYPE}" in btrfs|xfs|zfs) echo "[WARN] /var/swapfile unsupported on $${ROOT_FSTYPE} root: hibernation resume needs a swap file on ext4 (it stays unavailable; suspend still works)"; exit 1 ;; esac; SIZE_MB=$(( $(grep -w "MemTotal" /proc/meminfo | tr -dc "0-9") / 1024 )); [ "$SIZE_MB" -lt 4096 ] && SIZE_MB=4096; [ "$SIZE_MB" -gt 8192 ] && SIZE_MB=8192; NEED=$(( (SIZE_MB + 2048) * 1024 * 1024 )); AVAIL=$(df --output=avail -B1 / | tail -1); if [ "$AVAIL" -lt "$NEED" ]; then echo "[WARN] /var/swapfile creation skipped: insufficient free space on / (need $${NEED} bytes, have $${AVAIL}); hibernate stays unavailable"; exit 1; fi; dd if=/dev/zero of=/var/swapfile bs=1M count=$SIZE_MB conv=fsync && chmod 600 /var/swapfile && mkswap /var/swapfile && swapon /var/swapfile || { rm -f /var/swapfile; echo "[WARN] /var/swapfile creation failed; hibernate stays unavailable"; exit 1; }; fi'

[Install]
WantedBy=multi-user.target
